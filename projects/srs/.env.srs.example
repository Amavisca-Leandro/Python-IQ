# SRS Middleware - Email Service Configuration
# Copy this file to .env.srs and update with your actual values

# Email Service API Configuration
EMAIL_SERVICE_URL=http://localhost:3000
EMAIL_SERVICE_API_KEY=your-api-key-here
EMAIL_SERVICE_TIMEOUT=30
EMAIL_SERVICE_RETRIES=3

# Test Configuration
TEST_EMAIL_FROM=noreply@example.com
TEST_EMAIL_TO=test@example.com
