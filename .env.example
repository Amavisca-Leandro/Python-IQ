# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values
# The .env file should never be committed to version control

# Environment Selection
# Options: dev, staging, prod
ENV=dev

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Base URL for the API under test
API_BASE_URL=https://api.example.com

# API timeout in seconds
API_TIMEOUT=30

# Number of retry attempts for failed requests
API_RETRIES=3

# API version (if applicable)
API_VERSION=v1

# ============================================================================
# API RETRY & RESILIENCE
# ============================================================================
# Retry strategy for failed requests (exponential, linear, constant)
RETRY_STRATEGY=exponential

# Initial retry delay in seconds
RETRY_INITIAL_DELAY=1

# Maximum retry delay in seconds
RETRY_MAX_DELAY=10

# Backoff multiplier for exponential strategy
RETRY_BACKOFF_MULTIPLIER=2

# HTTP status codes to retry (comma-separated)
RETRY_STATUS_CODES=500,502,503,504,429

# Enable circuit breaker pattern (true/false)
ENABLE_CIRCUIT_BREAKER=false

# Circuit breaker failure threshold
CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker timeout in seconds
CIRCUIT_BREAKER_TIMEOUT=60

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Test user credentials for authentication
AUTH_USER=test_user@example.com
AUTH_PASSWORD=SecurePassword123!

# Admin user credentials (for tests requiring elevated permissions)
ADMIN_USER=admin@example.com
ADMIN_PASSWORD=AdminPassword123!

# API Key or Token (if using token-based auth instead of user/password)
API_KEY=your_api_key_here
API_TOKEN=your_api_token_here

# Authentication type (basic, bearer, oauth2, api_key)
AUTH_TYPE=bearer

# Token refresh endpoint (for automatic token refresh)
TOKEN_REFRESH_ENDPOINT=/auth/refresh

# Token expiration buffer in seconds (refresh before expiration)
TOKEN_EXPIRATION_BUFFER=300

# Enable automatic token refresh (true/false)
AUTO_REFRESH_TOKEN=true

# OAuth2 configuration (if using OAuth2)
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_SCOPE=
OAUTH2_TOKEN_URL=

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Base URL for the frontend application
FRONTEND_BASE_URL=https://app.example.com

# Browser selection for Playwright tests
# Options: chromium, firefox, webkit
BROWSER=chromium

# Run browser in headless mode (true/false)
HEADLESS=true

# Browser viewport size
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Slow down browser operations (milliseconds, useful for debugging)
SLOW_MO=0

# Default navigation timeout in milliseconds
NAVIGATION_TIMEOUT=30000

# Default action timeout in milliseconds (click, fill, etc.)
ACTION_TIMEOUT=10000

# Wait for network idle before considering navigation complete (true/false)
WAIT_FOR_NETWORK_IDLE=true

# Enable browser console log capture (true/false)
CAPTURE_CONSOLE_LOGS=true

# Enable trace recording for debugging (true/false)
ENABLE_TRACING=false

# Device emulation (leave empty for desktop, or use: iPhone 12, Pixel 5, etc.)
DEVICE_EMULATION=

# User agent override (leave empty for default)
USER_AGENT=

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Database connection details for SQLAlchemy
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_database
DB_USER=test_user
DB_PASSWORD=test_password

# Database driver (postgresql, mysql, sqlite, etc.)
DB_DRIVER=postgresql

# Database connection pool settings (SQLAlchemy Engine)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Pool pre-ping to verify connections before use (true/false)
DB_POOL_PRE_PING=true

# Pool recycle time in seconds (reconnect after this time)
DB_POOL_RECYCLE=3600

# Database schema (if applicable)
DB_SCHEMA=public

# Enable SQL query logging for debugging (true/false)
DB_ECHO=false

# Database isolation level (READ_COMMITTED, REPEATABLE_READ, SERIALIZABLE)
DB_ISOLATION_LEVEL=READ_COMMITTED

# ============================================================================
# TEST EXECUTION CONFIGURATION
# ============================================================================
# Number of parallel workers for test execution
# Use 'auto' to use number of CPU cores, or specify a number
PYTEST_WORKERS=auto

# Maximum number of test failures before stopping execution
MAX_FAILURES=5

# Test timeout in seconds (per test)
TEST_TIMEOUT=300

# Screenshot on failure (true/false)
SCREENSHOT_ON_FAILURE=true

# Video recording for UI tests (true/false)
VIDEO_RECORDING=false

# Retry failed tests automatically (number of retries)
PYTEST_RERUN_FAILURES=2

# Delay between retries in seconds
PYTEST_RERUN_DELAY=1

# Enable strict markers (fail on unknown markers)
PYTEST_STRICT_MARKERS=true

# Capture console output (yes, no, all)
PYTEST_CAPTURE=no

# Show extra test summary info (error, failed, passed, skipped, xfailed, xpassed)
PYTEST_VERBOSE_SUMMARY=error,failed

# ============================================================================
# REPORTING CONFIGURATION
# ============================================================================
# Allure report configuration
ALLURE_RESULTS_DIR=reports/allure-results
ALLURE_REPORT_DIR=reports/allure-report

# HTML report path
HTML_REPORT_PATH=reports/report.html

# ============================================================================
# INTEGRATION - ZEPHYR SCALE
# ============================================================================
# Zephyr Scale API configuration
ZEPHYR_API_URL=https://api.zephyrscale.smartbear.com/v2
ZEPHYR_API_TOKEN=your_zephyr_api_token_here
ZEPHYR_PROJECT_KEY=PROJ

# Enable/disable automatic sync to Zephyr (true/false)
ZEPHYR_SYNC_ENABLED=false

# Test cycle name for Zephyr (supports environment variable interpolation)
ZEPHYR_TEST_CYCLE=Automated Tests - ${ENV}

# Folder ID in Zephyr for organizing test cases
ZEPHYR_FOLDER_ID=

# Sync only on CI environment (true/false)
ZEPHYR_SYNC_ONLY_ON_CI=true

# Batch size for syncing test results
ZEPHYR_BATCH_SIZE=50

# ============================================================================
# INTEGRATION - JIRA
# ============================================================================
# Jira configuration for linking test results
JIRA_URL=https://your-company.atlassian.net
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=PROJ
JIRA_USER_EMAIL=your_email@example.com

# Enable automatic defect creation on test failure (true/false)
JIRA_AUTO_CREATE_DEFECTS=false

# Issue type for defects (Bug, Defect, etc.)
JIRA_DEFECT_ISSUE_TYPE=Bug

# Default priority for auto-created defects
JIRA_DEFECT_PRIORITY=Medium

# Labels to add to auto-created defects (comma-separated)
JIRA_DEFECT_LABELS=automated-test,regression

# ============================================================================
# INTEGRATION - SLACK
# ============================================================================
# Slack webhook for test notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#test-automation

# Enable/disable Slack notifications (true/false)
SLACK_NOTIFICATIONS_ENABLED=false

# Notify only on failures (true/false)
SLACK_NOTIFY_ON_FAILURE_ONLY=true

# Notify only on CI environment (true/false)
SLACK_NOTIFY_ONLY_ON_CI=true

# Include test summary in notifications (true/false)
SLACK_INCLUDE_SUMMARY=true

# Mention users on critical failures (comma-separated Slack user IDs)
SLACK_MENTION_ON_CRITICAL=

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level for test execution
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=reports/pytest.log

# Log format (simple, detailed, json)
LOG_FORMAT=detailed

# Enable colored logs in console (true/false)
LOG_COLORED=true

# Log HTTP requests and responses (true/false)
LOG_HTTP_REQUESTS=true

# Log database queries (true/false)
LOG_DB_QUERIES=false

# Maximum log file size in MB (0 = unlimited)
LOG_MAX_SIZE_MB=100

# Number of log files to keep (rotation)
LOG_BACKUP_COUNT=5

# ============================================================================
# DATA GENERATION & TEST DATA FACTORY
# ============================================================================
# Locale for Faker data generation (for localized test data)
FAKER_LOCALE=pt_BR

# Seed for reproducible random data (optional, leave empty for random)
FAKER_SEED=

# Enable automatic test data cleanup after test execution (true/false)
AUTO_CLEANUP_TEST_DATA=true

# Test data retention time in hours (0 = immediate cleanup)
TEST_DATA_RETENTION_HOURS=0

# Prefix for test data identification in database
TEST_DATA_PREFIX=test_

# Enable test data factory tracking (true/false)
ENABLE_DATA_FACTORY_TRACKING=true

# ============================================================================
# PERFORMANCE & MONITORING
# ============================================================================
# Enable performance metrics collection (true/false)
ENABLE_PERFORMANCE_METRICS=true

# API response time threshold in milliseconds (for warnings)
API_RESPONSE_TIME_THRESHOLD=2000

# UI page load time threshold in milliseconds (for warnings)
UI_PAGE_LOAD_THRESHOLD=5000

# Enable memory usage tracking (true/false)
TRACK_MEMORY_USAGE=false

# Enable flaky test detection (true/false)
DETECT_FLAKY_TESTS=true

# Number of runs to determine flakiness
FLAKY_TEST_RUNS=3

# ============================================================================
# CI/CD CONFIGURATION
# ============================================================================
# CI environment flag (automatically set by CI systems)
CI=false

# Build number or identifier (set by CI system)
BUILD_NUMBER=local

# Git branch name (set by CI system)
GIT_BRANCH=main

# ============================================================================
# TEST DATA ISOLATION & CLEANUP
# ============================================================================
# Enable test isolation (each test gets isolated data)
ENABLE_TEST_ISOLATION=true

# Use database transactions for test isolation (true/false)
USE_DB_TRANSACTIONS=true

# Cleanup strategy (immediate, deferred, manual)
CLEANUP_STRATEGY=immediate

# Enable parallel test execution safety (true/false)
PARALLEL_EXECUTION_SAFE=true

# Test data namespace (prefix for all test data)
TEST_DATA_NAMESPACE=autotest_

# ============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ============================================================================
# These can be overridden per environment (dev, staging, prod)

# Development environment specific settings
DEV_API_BASE_URL=http://localhost:8000
DEV_FRONTEND_BASE_URL=http://localhost:3000
DEV_DB_HOST=localhost

# Staging environment specific settings
STAGING_API_BASE_URL=https://staging-api.example.com
STAGING_FRONTEND_BASE_URL=https://staging.example.com
STAGING_DB_HOST=staging-db.example.com

# Production environment specific settings (use with caution!)
PROD_API_BASE_URL=https://api.example.com
PROD_FRONTEND_BASE_URL=https://app.example.com
PROD_DB_HOST=prod-db.example.com

# ============================================================================
# OPTIONAL INTEGRATIONS
# ============================================================================
# AWS credentials (if testing AWS services)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Email service (for testing email functionality)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# ============================================================================
# NOTES & BEST PRACTICES
# ============================================================================
# SECURITY:
# - Never commit the actual .env file to version control
# - Add .env to your .gitignore file (already configured)
# - Use strong passwords and rotate credentials regularly
# - For CI/CD, set these as environment variables or secrets
# - Sensitive values should be stored in secure secret management systems
# - Use different credentials for each environment
#
# USAGE:
# - Copy this file to .env: cp .env.example .env
# - Fill in your actual values in the .env file
# - The framework will automatically load variables from .env
# - Environment variables take precedence over .env file values
#
# CONFIGURATION:
# - Boolean values: use true/false (lowercase)
# - Numeric values: use plain numbers without quotes
# - String values: can be with or without quotes
# - Empty values: leave blank or use empty string ""
#
# ENVIRONMENT SELECTION:
# - Set ENV=dev for local development
# - Set ENV=staging for staging environment tests
# - Set ENV=prod for production-like environment (use with caution!)
# - Environment-specific variables will override base variables
#
# DATABASE:
# - Ensure database exists before running tests
# - Use separate test databases for each environment
# - Connection pooling is enabled by default for performance
# - SQLAlchemy will handle connection management automatically
#
# PARALLEL EXECUTION:
# - Adjust PYTEST_WORKERS based on your system resources
# - Use 'auto' to automatically detect CPU cores
# - Reduce workers if experiencing resource constraints
# - Ensure test data isolation is enabled for parallel execution
#
# INTEGRATIONS:
# - Zephyr and Jira integrations are optional
# - Set *_ENABLED=false to disable integrations
# - Slack notifications are useful for CI/CD pipelines
# - Configure only the integrations you need
#
# TROUBLESHOOTING:
# - Enable DEBUG log level for detailed troubleshooting
# - Set DB_ECHO=true to see all SQL queries
# - Use HEADLESS=false to see browser automation in action
# - Enable VIDEO_RECORDING=true to capture test execution videos
# - Check LOG_FILE for detailed execution logs
